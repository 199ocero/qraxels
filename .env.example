# Copied to .env by `npm run setup`.
PORT=4321
# Claude model for the bots (uses your own Claude Code login, never ANTHROPIC_API_KEY).
# VID_MODEL=claude-sonnet-5-5  # optional: one model for every bot
# Voice driver: kokoro (free, local) or elevenlabs.
VID_VOICE=kokoro
KOKORO_VOICE=af_heart
# Kokoro voice for motivation videos (af_heart reads angriest of its female voices; am_onyx,am_michael for a deep male).
KOKORO_VOICE_MONO=af_heart
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Voice engine for the videos (falls back to VID_VOICE): kokoro or elevenlabs.
VID_VOICE_MONO=
# Optional: a different ElevenLabs voice for motivation videos.
ELEVENLABS_VOICE_ID_MONO=
# Motivation music: auto (rotate through public/sound/music/), a file name there (always that track), or off (no music:
# add a sound inside TikTok instead; the sound effects stay).
MONO_MUSIC=auto
# Music for Explained videos: auto (rotate through public/sound/music/calm/), a file name there, or off.
EXPLAINED_MUSIC=auto
